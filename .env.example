# Demo on loopback only. Set a private password (at least 12 characters) before npm run seed.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/golina.sqlite
DEMO_PASSWORD=
# For trusted HTTPS reverse proxy only; required when exposing on a LAN.
SECURE_COOKIE=false
# Bridge account, obtained with POST /api/login, or set these for the CLI:
SERVER_URL=http://127.0.0.1:3000
BRIDGE_USERNAME=bridge
BRIDGE_PASSWORD=
VMIX_URL=http://127.0.0.1:8088
VMIX_INPUT=
VMIX_OVERLAY=1
OVERLAY_SECONDS=15
BRIDGE_STATE=./data/bridge-state.json
