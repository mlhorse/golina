{
  "name": "golina-e-sesja",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "build": "tsc --noEmit && vite build",
    "seed": "node --env-file-if-exists=.env src/seed.ts",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "bridge": "node --env-file-if-exists=.env bridge/cli.ts",
    "backup": "node --env-file-if-exists=.env src/backup.ts",
    "demo:setup": "node --env-file-if-exists=.env src/setup-demo.ts",
    "dev:web": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
